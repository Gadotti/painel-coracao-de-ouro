# Copie para .env (não commitar). Todas as variáveis são opcionais.
PORT=4242
HOST=0.0.0.0
LOG_LEVEL=info

# Arquivo gerado pelo coletor. No container, monte a pasta do tmpfs do host em /dados.
STATUS_PATH=./data/status.json
# Depois de quantos segundos sem atualização o status é considerado velho.
STATUS_STALE_AFTER_S=180

# Verbetes próprios (nomes dos seus agentes/programas e roadmap). Opcional.
# THEME_PATH=./data/theme.json

# Autenticação HTTP Basic opcional. Defina os dois ou nenhum.
# Gere o hash com: npm run hash-password
# PANEL_USER=mochileiro
# PANEL_PASSWORD_HASH=scrypt:32768:8:1:...
