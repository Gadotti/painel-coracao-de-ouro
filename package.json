{
  "name": "painel-coracao-de-ouro",
  "version": "0.1.1",
  "description": "Painel de controle 8-bit para servidores caseiros (Raspberry Pi), temático do Guia do Mochileiro das Galáxias.",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "author": "Eduardo Gadotti",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gadotti/painel-coracao-de-ouro.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:coletor-falso": "node scripts/fake-collector.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "hash-password": "node scripts/hash-password.js",
    "release:zip": "node scripts/release-zip.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
